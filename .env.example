VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional isolated, fictional design preview. Never enable on production.
VITE_ENABLE_DEMO=false

# Public Turnstile site key only; put the secret key in Supabase Auth settings.
# Leave empty until a real widget is configured.
VITE_TURNSTILE_SITE_KEY=

# Server only: never prefix these with VITE_.
# Production origin must be the exact HTTPS origin used for admin login.
PAYINDEX_APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Generate 32 random bytes, base64 encoded. Keep secret; leave empty in Git.
PAYINDEX_COOKIE_SECRET=
